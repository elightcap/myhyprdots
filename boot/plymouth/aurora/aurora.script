# Aurora: Catppuccin Mocha boot splash. Logo + pulsing aurora dots while
# booting; a translucent field with bullets when the LUKS passphrase is asked.

Window.SetBackgroundTopColor(0.118, 0.118, 0.180);
Window.SetBackgroundBottomColor(0.067, 0.067, 0.106);

W = Window.GetWidth();
H = Window.GetHeight();
CX = Window.GetX() + W / 2;
CY = Window.GetY() + H / 2;

# ---- background: scale to cover, keep aspect ---------------------------
bg_img = Image("background.png");
s = Math.Max(W / bg_img.GetWidth(), H / bg_img.GetHeight());
bg_scaled = bg_img.Scale(bg_img.GetWidth() * s, bg_img.GetHeight() * s);
bg = Sprite(bg_scaled);
bg.SetPosition(CX - bg_scaled.GetWidth() / 2, CY - bg_scaled.GetHeight() / 2, -100);

# ---- logo + title -------------------------------------------------------
logo_img = Image("logo.png");
logo = Sprite(logo_img);
logo.SetPosition(CX - logo_img.GetWidth() / 2, CY - H * 0.20 - logo_img.GetHeight() / 2, 10);

title_img = Image("title.png");
title = Sprite(title_img);
title.SetPosition(CX - title_img.GetWidth() / 2, CY - H * 0.20 + logo_img.GetHeight() / 2 + 28, 10);

# ---- loader dots --------------------------------------------------------
DOTS = 5;
GAP = 34;
dots_y = CY + H * 0.12;
for (i = 0; i < DOTS; i++) {
  dot_img[i] = Image("dot" + i + ".png");
  dot[i] = Sprite(dot_img[i]);
  dot[i].SetPosition(CX - ((DOTS - 1) * GAP) / 2 + i * GAP - 8, dots_y, 10);
}

# farewell text for shutdown / reboot
mode = Plymouth.GetMode();
if (mode == "shutdown" || mode == "reboot") {
  if (mode == "shutdown") bye_img = Image("bye.png");
  else bye_img = Image("restart.png");
  bye = Sprite(bye_img);
  bye.SetPosition(CX - bye_img.GetWidth() / 2, dots_y + 50, 10);
}

# ---- password prompt ----------------------------------------------------
prompt_img = Image("prompt.png");
prompt = Sprite(prompt_img);
prompt.SetPosition(CX - prompt_img.GetWidth() / 2, CY + H * 0.03, 20);
prompt.SetOpacity(0);

entry_img = Image("entry.png");
entry = Sprite(entry_img);
entry_x = CX - entry_img.GetWidth() / 2;
entry_y = CY + H * 0.03 + prompt_img.GetHeight() + 22;
entry.SetPosition(entry_x, entry_y, 20);
entry.SetOpacity(0);

bullet_img = Image("bullet.png");
MAX_BULLETS = 24;
BULLET_GAP = 24;
for (i = 0; i < MAX_BULLETS; i++) {
  bullet[i] = Sprite(bullet_img);
  bullet[i].SetZ(30);
  bullet[i].SetOpacity(0);
}

asking = 0;

fun show_dots(op) {
  for (i = 0; i < DOTS; i++) global.dot[i].SetOpacity(op);
}

fun display_password_callback(prompt_text, count) {
  global.asking = 1;
  show_dots(0);
  global.prompt.SetOpacity(1);
  global.entry.SetOpacity(1);
  n = Math.Min(count, global.MAX_BULLETS);
  row = (n - 1) * global.BULLET_GAP;
  for (i = 0; i < global.MAX_BULLETS; i++) {
    if (i < n) {
      global.bullet[i].SetPosition(global.CX - row / 2 + i * global.BULLET_GAP - 9,
                                   global.entry_y + global.entry_img.GetHeight() / 2 - 9, 30);
      global.bullet[i].SetOpacity(1);
    } else {
      global.bullet[i].SetOpacity(0);
    }
  }
}

fun display_normal_callback() {
  global.asking = 0;
  global.prompt.SetOpacity(0);
  global.entry.SetOpacity(0);
  for (i = 0; i < global.MAX_BULLETS; i++) global.bullet[i].SetOpacity(0);
  show_dots(1);
}

# ---- status messages (rare: fsck, errors) ------------------------------
msg = Sprite();
msg.SetZ(40);
fun message_callback(text) {
  img = Image.Text(text, 0.729, 0.761, 0.871, 1);
  global.msg.SetImage(img);
  global.msg.SetPosition(global.CX - img.GetWidth() / 2, Window.GetY() + global.H * 0.88, 40);
}

# ---- animation: a wave of light travelling through the dots -----------
t = 0;
fun refresh_callback() {
  global.t++;
  if (!global.asking) {
    for (i = 0; i < global.DOTS; i++) {
      w = Math.Sin(global.t * 0.07 - i * 0.7);
      global.dot[i].SetOpacity(0.25 + 0.75 * (0.5 + 0.5 * w));
      global.dot[i].SetY(global.dots_y - 6 * Math.Max(w, 0));
    }
  }
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetMessageFunction(message_callback);
