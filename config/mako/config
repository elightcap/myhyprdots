# Catppuccin Mocha notifications. SUPER + COMMA dismisses,
# SUPER + CTRL + ALT + COMMA toggles do-not-disturb.
font=CaskaydiaMono Nerd Font Propo 11
background-color=#1e1e2ee8
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #45475a
border-size=2
border-radius=12
padding=14
margin=12
outer-margin=6
width=400
height=220
icons=1
max-icon-size=48
max-visible=5
default-timeout=6000
anchor=top-right
layer=overlay
format=<b>%s</b>\n%b

[urgency=low]
border-color=#45475a

[urgency=critical]
border-color=#fab387
default-timeout=0

[mode=do-not-disturb]
invisible=1
