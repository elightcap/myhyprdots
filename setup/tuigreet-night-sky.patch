+#[cfg(test)]
+mod tests {
+  use super::*;
+
+  fn fixed(opts: Options) -> Night {
+    let mut n = Night::new(opts);
+    n.rng = StdRng::seed_from_u64(7);
+    n
+  }
+
+  #[test]
+  fn scatters_stars_by_density() {
+    let mut n = fixed(Options::default());
+    n.resize(Rect::new(0, 0, 200, 50));
+    let expected = (200.0 * 49.0 * 0.017) as usize;
+    assert!(n.stars.len() >= expected * 9 / 10, "{}", n.stars.len());
+    assert!(n.stars.iter().all(|s| s.y < 49), "status row must stay clear");
+  }
+
+  #[test]
+  fn moon_is_drawn_and_kept_free_of_stars() {
+    let mut n = fixed(Options::default());
+    n.resize(Rect::new(0, 0, 200, 50));
+    assert!(n.moon.iter().any(|c| c.ch == '█'), "moon needs a solid body");
+    for s in &n.stars {
+      assert!(!n.in_moon_halo(f32::from(s.x) + 0.5, f32::from(s.y) + 0.5));
+    }
+  }
+
+  #[test]
+  fn no_moon_on_tiny_screens() {
+    let mut n = fixed(Options::default());
+    n.resize(Rect::new(0, 0, 30, 10));
+    assert!(n.moon.is_empty());
+  }
+
+  #[test]
+  fn meteors_spawn_and_burn_out() {
+    let mut n = fixed(Options {
+      meteor_chance: 1.0,
+      ..Options::default()
+    });
+    n.resize(Rect::new(0, 0, 200, 50));
+    n.step();
+    assert!(!n.meteors.is_empty());
+    n.opts.meteor_chance = 0.0;
+    for _ in 0..60 {
+      n.step();
+    }
+    assert!(n.meteors.is_empty(), "meteors must expire");
+  }
+
+  #[test]
+  fn satellite_crosses_and_leaves() {
+    let mut n = fixed(Options {
+      meteor_chance: 0.0,
+      satellite_chance: 1.0,
+      ..Options::default()
+    });
+    n.resize(Rect::new(0, 0, 200, 50));
+    n.step();
+    let start = n.satellite.expect("satellite should spawn");
+    n.opts.satellite_chance = 0.0;
+    for _ in 0..5 {
+      n.step();
+    }
+    let later = n.satellite.expect("still crossing");
+    assert!((later.x - start.x).abs() > 0.5, "it should move");
+    assert!((later.y - start.y).abs() < 1.0, "path is nearly level");
+    for _ in 0..2000 {
+      n.step();
+    }
+    assert!(n.satellite.is_none(), "it should leave the screen");
+  }
+
+  #[test]
+  fn renders_inside_area() {
+    let mut n = fixed(Options::default());
+    let area = Rect::new(0, 0, 120, 40);
+    n.resize(area);
+    let mut buf = Buffer::empty(area);
+    for _ in 0..30 {
+      n.step();
+    }
+    n.render(area, &mut buf);
+    let painted = buf.content.iter().filter(|c| c.symbol() != " ").count();
+    assert!(painted > 20);
+  }
+}
